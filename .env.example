OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
SEMIDEBUG_JSON_MODE=false
SEMIDEBUG_MAX_ITERATIONS=3
SEMIDEBUG_API_TIMEOUT=60
# Optional USD per million tokens; supply a source/date when setting prices.
SEMIDEBUG_INPUT_PRICE=
SEMIDEBUG_OUTPUT_PRICE=
SEMIDEBUG_PRICE_SOURCE=

# Default local LLM path: normal ChatGPT-authenticated Codex CLI, no API key needed.
SEMIDEBUG_CODEX_MODEL=gpt-6-sol
SEMIDEBUG_REASONING_EFFORT=low
SEMIDEBUG_CODEX_TIMEOUT=180
