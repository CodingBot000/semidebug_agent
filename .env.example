OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
SEMIDEBUG_JSON_MODE=false
SEMIDEBUG_MAX_ITERATIONS=3
SEMIDEBUG_API_TIMEOUT=180
# Optional USD per million tokens. Values below are for gpt-6-sol on 2026-09-24;
# update all four fields together when changing model or pricing date.
SEMIDEBUG_INPUT_PRICE=2
SEMIDEBUG_CACHED_INPUT_PRICE=0.2
SEMIDEBUG_OUTPUT_PRICE=10
SEMIDEBUG_PRICE_SOURCE=OpenAI gpt-6-sol pricing 2026-09-24

SEMIDEBUG_REASONING_EFFORT=low
